<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 需要 windows10.0.19041.0 目标才能使用 WinRT SMTC API（Windows.Media.Control），
         使用 SDK 内置的 Windows 目标包 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>TaskbarLyrics</AssemblyName>
    <RootNamespace>TaskbarLyrics</RootNamespace>
    <!-- 单文件发布时一起打包 Skia 原生库，首次运行由 .NET 解压加载。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 发布版本号：打 tag 发 release 时同步递增（检查更新以此对比） -->
    <Version>1.0.32</Version>
  </PropertyGroup>

  <!-- 避免 WinForms/Drawing 的隐式 using 与 WPF 类型（Color/Brush/Application 等）冲突；
       TrayIcon.cs 里已显式 using System.Windows.Forms -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- 原生模块作为资源随单文件发布；构建输出留在 obj，运行时按内容散列解包。 -->
  <ItemGroup>
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)native/Release/TaskbarLyricsHook19.dll" LogicalName="LyricsHook.dll" />
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)native/Release/LyricsHookInjector.exe" LogicalName="LyricsHookInjector.exe" />
    <EmbeddedResource Include="../../native/LyricsHook/THIRD-PARTY.txt" LogicalName="LyricsHook.Licenses.txt" />
  </ItemGroup>
  <Target Name="BuildLyricsHook" BeforeTargets="PrepareForBuild"
          Inputs="../../native/LyricsHook/CMakeLists.txt;../../native/LyricsHook/Hook.cpp;../../native/LyricsHook/DrawSources.h;../../native/LyricsHook/DrawCapture.h;../../native/LyricsHook/Injector.cpp;../../native/LyricsHook/Protocol.h;../../native/LyricsHook/Probe.cpp"
          Outputs="$(BaseIntermediateOutputPath)native/Release/TaskbarLyricsHook19.dll;$(BaseIntermediateOutputPath)native/Release/LyricsHookInjector.exe;$(BaseIntermediateOutputPath)native/Release/LyricsHookProbe.exe">
    <Exec Command="cmake -S &quot;$(MSBuildProjectDirectory)/../../native/LyricsHook&quot; -B &quot;$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)native&quot; -A x64" />
    <Exec Command="cmake --build &quot;$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)native&quot; --config Release" />
  </Target>

</Project>
